*_override.tf.json

# Commit the root .terraform.lock.hcl once the module declares providers, so
# dependabot can bump them. Examples are validate-only and not covered by
# dependabot, so theirs would go stale.
examples/**/.terraform.lock.hcl

# Local env files
.env
.env.*
!.env.example
